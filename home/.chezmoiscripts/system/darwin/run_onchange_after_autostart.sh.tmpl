{{- if .is_mac -}}

#!/usr/bin/env bash

# Disable autostart for apps that slow down login (launch them on demand instead)

set -euo pipefail

{{ template "common.tmpl" . }}

log_info "Disabling app autostart..."

###############################################################################
# Docker Desktop                                                              #
###############################################################################

# Disable AutoStart in the settings store (skipped while Docker Desktop runs:
# it would overwrite the file on quit)
docker_settings="${HOME}/Library/Group Containers/group.com.docker/settings-store.json"
if [[ -f "${docker_settings}" ]]; then
    if pgrep -qf "Docker Desktop"; then
        log_warn "Docker Desktop is running, skipping AutoStart change"
    else
        python3 - "${docker_settings}" <<'PYEOF'
import json
import sys

path = sys.argv[1]
with open(path) as f:
    settings = json.load(f)

if settings.get("AutoStart"):
    settings["AutoStart"] = False
    with open(path, "w") as f:
        json.dump(settings, f, indent=2)
PYEOF
        log_success "Docker Desktop autostart disabled"
    fi
fi

{{ if and .is_apple_silicon .user_veberarnaud -}}
###############################################################################
# DMC menu bar app                                                            #
###############################################################################

# Start DMC.app at login through a login item (a path, so it survives updates).
# The app is installed by run_onchange_after_dmc_app.sh.tmpl, which runs after
# this script: on the first apply the app is missing and this block is not
# rendered, the next apply registers it.
{{ if stat "/Applications/DMC.app" -}}
# Match by path, not by name: an old manual install (for example
# ~/Downloads/DMC.app) registers a login item named "DMC" too. Replace that
# entry with the /Applications one; never touch a login item of another app.
dmc_login_paths="$(osascript -e 'tell application "System Events" to get the path of every login item' 2>/dev/null || true)"
dmc_registered=false
dmc_old_path=""
IFS=',' read -ra dmc_paths <<< "${dmc_login_paths}"
for dmc_path in "${dmc_paths[@]}"; do
    dmc_path="${dmc_path# }"
    [[ -z "${dmc_path}" ]] && continue
    if [[ "${dmc_path}" == "/Applications/DMC.app" ]]; then
        dmc_registered=true
    elif [[ "${dmc_path}" == */DMC.app ]]; then
        dmc_old_path="${dmc_path}"
    fi
done

if [[ "${dmc_registered}" == true ]]; then
    log_info "DMC.app already starts at login"
elif [[ -n "${dmc_old_path}" ]]; then
    if osascript -e "tell application \"System Events\" to delete (every login item whose path is \"${dmc_old_path}\")" &>/dev/null \
        && osascript -e 'tell application "System Events" to make login item at end with properties {path:"/Applications/DMC.app", hidden:false}' &>/dev/null; then
        log_success "DMC.app login item replaced (was ${dmc_old_path})"
    else
        log_warn "Could not replace the login item pointing to ${dmc_old_path} (allow the terminal to control System Events, or fix it in System Settings > General > Login Items)"
    fi
elif osascript -e 'tell application "System Events" to make login item at end with properties {path:"/Applications/DMC.app", hidden:false}' &>/dev/null; then
    log_success "DMC.app set to start at login"
else
    log_warn "Could not add DMC.app to the login items (allow the terminal to control System Events, or add it in System Settings > General > Login Items)"
fi
{{ else -}}
log_warn "DMC.app is not installed yet: run \`chezmoi apply\` again to register it as a login item"
{{ end -}}

{{ end -}}
log_success "Autostart configuration complete"

{{- end -}}
