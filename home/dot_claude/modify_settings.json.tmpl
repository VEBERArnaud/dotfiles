#!/usr/bin/env bash
# chezmoi modify script for ~/.claude/settings.json.
#
# Claude Code rewrites this file with its own state (agentPushNotifEnabled and
# the other preferences toggled from /config or the mobile app) and reorders
# the keys when it does. Only the top-level keys in MANAGED are enforced by
# chezmoi, each replaced as a whole; every other key is passed through
# untouched, in the order Claude Code wrote it, so the app-owned settings
# never show up in `chezmoi diff`.
set -euo pipefail

if ! command -v jq >/dev/null 2>&1; then
    echo "jq is required to manage ~/.claude/settings.json" >&2
    exit 1
fi

MANAGED='{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash([ *)",
      "Bash([[ *)",
      "Bash(awk *)",
      "Bash(bat *)",
      "Bash(cat *)",
      "Bash(chmod *)",
      "Bash(cp *)",
      "Bash(delta *)",
      "Bash(echo *)",
      "Bash(fzf *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(printf *)",
      "Bash(rg *)",
      "Bash(shellcheck *)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(test *)",
      "Bash(touch *)",
      "Bash(tree *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(zoxide *)"
    ],
    "deny": [
      "Bash(chmod -R 777 *)",
      "Bash(chmod 777 *)",
      "Bash(git push --force origin main)",
      "Bash(git push --force origin master)",
      "Bash(git push -f origin main)",
      "Bash(git push -f origin master)",
      "Bash(git reset --hard origin/*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo rm -rf *)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable[1m]",
  "remoteControlAtStartup": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hook.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hook.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hook.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hook.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hook.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hook.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
{{- $plugins := list -}}
{{- $plugins = append $plugins "    \"mattpocock-skills@claude-plugins-official\": true" -}}
{{- if .project_eurosport -}}
{{-   $plugins = append $plugins "    \"eurosport@eurosport\": true" -}}
{{-   $plugins = append $plugins "    \"js-to-ts-converter@eurosport\": true" -}}
{{- end -}}
{{- if .with_javascript -}}
{{-   $plugins = append $plugins "    \"frontend-design@claude-plugins-official\": true" -}}
{{- end -}}
{{- if .with_rust -}}
{{-   $plugins = append $plugins "    \"rust-analyzer-lsp@claude-plugins-official\": true" -}}
{{- end -}}
{{- if .with_swift -}}
{{-   $plugins = append $plugins "    \"swift-lsp@claude-plugins-official\": true" -}}
{{- end -}}
{{- if gt (len $plugins) 0 }},
  "enabledPlugins": {
{{ join ",\n" $plugins }}
  }
{{- end }},
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest"
}'

# Empty stdin: the target does not exist yet (first apply, CI).
current="$(cat)"
if [[ -z "${current//[[:space:]]/}" ]]; then
    current='{}'
fi

printf '%s\n' "${current}" | jq --argjson managed "${MANAGED}" '. + $managed'
