#!/usr/bin/env python3
"""chezmoi modify script for ~/.codex/config.toml.

The Codex/ChatGPT app rewrites this file with its own state (plugins,
marketplaces, mcp_servers, desktop settings, ...). Only the keys listed
in MANAGED are enforced by chezmoi; every other line is passed through
untouched so the app-owned sections never show up in `chezmoi diff`.

The MCP servers themselves are added by run_after_codex_mcp.sh.tmpl with
`codex mcp add`, except `dmc`: that command cannot declare a headers
helper, so its section is enforced here. Its URL is read from 1Password
when chezmoi renders this script, and the API key is not in it —
`http_headers_helper` runs ~/.local/bin/dmc-mcp-headers on every
connection, which reads ~/.config/dmc/api-key, rendered from 1Password by
chezmoi.
"""

import re
import sys

# {section: {key: raw TOML value}}; None = top-level keys
MANAGED = {
    None: {
        "model": '"gpt-6-astra"',
        "model_reasoning_effort": '"xhigh"',
        "approval_policy": '"on-request"',
        "sandbox_mode": '"workspace-write"',
    },
    "sandbox_workspace_write": {
        "network_access": "true",
    },
{{- /* The instance URL lives in 1Password, not in this repository; CI has
       no session, so the section is simply absent there. */ -}}
{{- $dmcUrl := "" }}
{{- if and .user_veberarnaud (not (env "CI")) }}
{{-   $dmcUrl = onepasswordRead "op://Personal/DMC/website" | trimSuffix "/" }}
{{- end }}
{{- if $dmcUrl }}
    "mcp_servers.dmc": {
        "url": '"{{ $dmcUrl }}/api/mcp"',
        "http_headers_helper": '"{{ .chezmoi.homeDir }}/.local/bin/dmc-mcp-headers"',
    },
{{- end }}
}

SECTION_RE = re.compile(r"^\s*\[([^\]]+)\]")
KEY_RE = re.compile(r"^\s*([A-Za-z0-9_-]+)\s*=")


def flush_missing(pending, section):
    keys = pending.get(section)
    if not keys:
        return []
    lines = [f"{key} = {value}" for key, value in keys.items()]
    keys.clear()
    return lines


def main():
    pending = {section: dict(keys) for section, keys in MANAGED.items()}
    section = None
    out = []

    for line in sys.stdin.read().splitlines():
        section_match = SECTION_RE.match(line)
        if section_match:
            out.extend(flush_missing(pending, section))
            section = section_match.group(1)
            out.append(line)
            continue
        key_match = KEY_RE.match(line)
        if key_match and key_match.group(1) in pending.get(section, {}):
            key = key_match.group(1)
            out.append(f"{key} = {pending[section].pop(key)}")
        else:
            out.append(line)

    out.extend(flush_missing(pending, section))
    for missing_section, keys in pending.items():
        if keys and missing_section is not None:
            out.extend(["", f"[{missing_section}]"])
            out.extend(flush_missing(pending, missing_section))

    sys.stdout.write("\n".join(out) + "\n")


if __name__ == "__main__":
    main()
