{{- $isCI := env "CI" | not | not -}}

{{- $hostsWithSSHKey := list
    "VEBERArnaud-MacMini2023"
    "VEBERArnaud-MacMini2023s"
    "VEBERArnaud-MacBookPro2023"
    "VEBERArnaud-MacMini2026"
-}}
{{- $hasSSHKey := has .chezmoi.hostname $hostsWithSSHKey -}}

{{- $sshFiles := list
    ".ssh/id_ed25519"
    ".ssh/id_ed25519.pub"
-}}

{{- $opFiles := list
    ".aws/config"
    ".chezmoiscripts/security/gpg_import.sh"
    ".chezmoiscripts/tools/gws_auth.sh"
    ".config/.jira"
    ".config/dmc/api-key"
    ".npmrc"
    ".okta_aws_login_config"
    ".ssh/authorized_keys"
    ".ssh/config.local"
    ".zshenv.d/40-eurosport-jira.sh"
    ".zshenv.d/41-things3.sh"
-}}

# SSH keys (only on specific hosts)
{{- if not $hasSSHKey }}
{{- range $sshFiles }}
{{ . }}
{{- end }}
{{- end }}

# Files requiring 1Password (ignore in CI)
{{- if $isCI }}
{{- range $opFiles }}
{{ . }}
{{- end }}
{{- end }}

# Project-scoped files
{{- if not .project_eurosport }}
.config/.jira
.okta_aws_login_config
.zshenv.d/40-eurosport-jira.sh
{{- end }}

{{- if not .with_aws }}
.aws/config
{{- end }}

# User-scoped files
{{- if not (or .user_dmc .user_emmett) }}
.ssh/authorized_keys
{{- end }}
{{- if not .user_dmc }}
.local/bin/dmc-backup
.local/bin/dmc-logrotate
Library/LaunchAgents/pw.veber.dmc.plist
Library/LaunchAgents/pw.veber.dmc-backup.plist
Library/LaunchAgents/pw.veber.dmc-logrotate.plist
{{- end }}

# Tool-scoped files
{{- if not .with_javascript }}
.npmrc
.nvm
{{- end }}
