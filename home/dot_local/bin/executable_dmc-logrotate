#!/usr/bin/env bash
# Rotates the DMC server log, run daily by the pw.veber.dmc-logrotate launch
# agent on the DMC host.
#
# launchd keeps the log open in append mode for the life of `dmcli start`, and
# DMC never reopens it: the log is copied then truncated in place, so DMC keeps
# writing to the same file without a restart. Lines written between the copy
# and the truncation are lost (a few milliseconds).
#
# Usage:
#   dmc-logrotate            # dmc.log -> dmc.log.1.gz, keeps KEEP archives
set -euo pipefail

readonly LOG="${HOME}/.local/share/dmc/logs/dmc.log"
readonly KEEP=14

# Nothing to rotate
[[ -s "${LOG}" ]] || exit 0

# Shift the archives: dmc.log.13.gz -> dmc.log.14.gz, ..., the oldest is dropped
rm -f "${LOG}.${KEEP}.gz"
for ((i = KEEP - 1; i >= 1; i--)); do
    if [[ -f "${LOG}.${i}.gz" ]]; then
        mv -f "${LOG}.${i}.gz" "${LOG}.$((i + 1)).gz"
    fi
done

cp -f "${LOG}" "${LOG}.1"
: > "${LOG}"
gzip -f "${LOG}.1"
